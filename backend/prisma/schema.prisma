generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String

  basePrice   Decimal  @db.Decimal(10, 2)
  pricePerKey Decimal  @default(0) @db.Decimal(10, 2)

  minKeys     Int      @default(1)
  maxKeys     Int      @default(52)

  active      Boolean  @default(true)

  baseWeightGrams   Int @default(0)
  weightGrams Int      @default(1)
  weightPerKeyGrams Int @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  colors      ProductColor[]
  fonts       ProductFont[]
  images      ProductImage[]

  orderItems  OrderItem[]
}

model Color {
  id        Int      @id @default(autoincrement())
  name      String  @unique
  hex       String
  filamentCode String?

  createdAt DateTime @default(now())

  products  ProductColor[]
}

model Font {
  id        Int      @id @default(autoincrement())
  name      String
  bordered  Boolean @default(false)

  createdAt DateTime @default(now())

  products  ProductFont[]
}

model ProductColor {
  productId Int
  colorId   Int

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@id([productId, colorId])
}

model ProductFont {
  productId Int
  fontId    Int

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  font      Font    @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@id([productId, fontId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Customer {
  id        Int      @id @default(autoincrement())

  name      String
  email     String
  phone     String?

  address   String?
  postalCode String?
  city      String?
  country   String? @default("Portugal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model Order {
  id          Int      @id @default(autoincrement())

  status      OrderStatus @default(PENDING)

  subtotal    Decimal  @db.Decimal(10, 2)
  shipping    Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  items       OrderItem[]

  totalWeightGrams Int

  shippingName       String
  shippingAddress    String
  shippingPostalCode String
  shippingCity       String
  shippingCountry    String @default("Portugal")
  
  shippingProvider String?
  shippingService  String?
  
  paymentProvider  String?
  paymentMethod    String?
  paymentReference String?
  paymentStatus    PaymentStatus @default(PENDING)
  paidAt           DateTime?

  trackingCode  String?
  trackingUrl   String?
  shippedAt     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  quantity    Int      @default(1)

  keys        Int
  characters  String?

  colorName   String?
  colorHex    String?

  fontName    String?
  bordered    Boolean @default(false)
  
  unitWeightGrams Int?
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)

  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model PostalCode {
  id Int @id @default(autoincrement())

  districtCode String
  countyCode   String
  localityCode String
  locality     String

  streetCode String?
  streetType String?
  streetPreposition String?
  streetTitle String?
  streetPreposition2 String?
  streetName String?

  extra1 String?
  extra2 String?
  extra3 String?
  extra4 String?

  postalCode4 String
  postalCode3 String
  postalDesignation String

  rawLine String?

  createdAt DateTime @default(now())

  @@index([postalCode4, postalCode3])
  @@index([locality])
  @@index([streetCode])
}